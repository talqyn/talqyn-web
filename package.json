{
  "name": "@talqyn/web",
  "version": "1.0.0",
  "description": "Web SDK for the Talqyn public API: smart search, facets, and the LLM consultant, with the consultant screen as a web component.",
  "license": "MIT",
  "author": {
    "name": "Talqyn",
    "url": "https://talqyn.com"
  },
  "homepage": "https://github.com/talqyn/talqyn-web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talqyn/talqyn-web.git"
  },
  "bugs": {
    "url": "https://github.com/talqyn/talqyn-web/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/sdk/index.js",
  "types": "./dist/sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./consultant-core": {
      "types": "./dist/consultant-core/index.d.ts",
      "default": "./dist/consultant-core/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./global": "./dist/talqyn.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
